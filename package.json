{
  "name": "act-sample-todo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build:client && bun --hot src/server/index.tsx",
    "build:client": "bun build ./src/client/main.tsx --outdir ./public --target browser",
    "start": "bun run build:client && bun src/server/index.tsx",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "bun test",
    "audit": "bun audit"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@happy-dom/global-registrator": "^20.14.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.1.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^19.2.7",
    "happy-dom": "^20.14.0",
    "typescript": "^5.5.0"
  }
}
